# Copia este archivo como .env y completa tus datos.
DB_USER=system
DB_PASSWORD=
DB_DSN=localhost:1521/XE

# Solo para Oracle 11g (modo thick): carpeta bin del cliente Oracle.
# Ejemplo en Windows: C:\oraclexe\app\oracle\product\11.2.0\server\bin
ORACLE_CLIENT_DIR=

# Clave para firmar las sesiones de Flask. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
